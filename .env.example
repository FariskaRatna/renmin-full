# SIERA DELTA LIMA — contoh konfigurasi .env root
# Salin ke .env di server, isi nilainya, lalu: chmod 600 .env
# JANGAN commit .env ke Git.

# --- Database (dibuat otomatis di volume Docker sdl_root_r1_pgdata) ---
# WAJIB persis 'sdl_root_dev' — scripts/reset-all-passwords.sh:17 dan
# scripts/seed-bagrenmin-users.sh:11 menolak jalan kalau nilainya lain.
SDL_DB_NAME=sdl_root_dev
SDL_DB_USER=sdl_app
# Bebas, tanpa karakter @ : / ? # (dipakai di dalam URL koneksi)
SDL_DB_PASSWORD=GANTI_DENGAN_HASIL_openssl_rand_hex_24

# --- Kunci aplikasi: WAJIB 64 karakter hex (32 byte) ---
# Buat dengan: openssl rand -hex 32
SDL_AUTH_SECRET=GANTI_64_HEX
SDL_EVIDENCE_KEY=GANTI_64_HEX_BERBEDA

# --- Akses jaringan ---
# Di mode reverse proxy, frontend TIDAK perlu terekspos ke LAN: biarkan di
# loopback dan biarkan Caddy yang melayani jaringan di port 443.
# 127.0.0.1 = hanya dari server itu sendiri (dipakai mode HTTPS di bawah)
# 0.0.0.0   = port 5174 langsung terbuka ke LAN (TIDAK bisa login, lihat catatan)
SDL_BIND_ADDR=127.0.0.1
SDL_FRONTEND_PORT=5174
# Host/IP yang diizinkan Vite. Pisahkan dengan koma, tanpa port.
# Wajib memuat host yang dipakai di SDL_PUBLIC_ORIGIN.
SDL_ALLOWED_HOSTS=172.16.173.34

# --- HTTPS reverse proxy (infra/compose.proxy.yaml) ---
# Login WAJIB secure context: CAPTCHA di LocalCaptcha.tsx:24 memakai
# crypto.subtle, yang tidak tersedia pada http:// ke alamat IP. Jadi akses
# http://<ip>:5174 tidak akan pernah bisa login — harus lewat https.
SDL_PUBLIC_ORIGIN=https://172.16.173.34
# Host telanjang tanpa skema; WAJIB, dipakai Caddyfile untuk default_sni.
SDL_PUBLIC_HOST=172.16.173.34
# Origin yang boleh melakukan mutation (CSRF), dipisah koma. WAJIB memuat
# SDL_PUBLIC_ORIGIN; kosong = semua mutation 403, tampil sebagai "CAPTCHA gagal".
SDL_ALLOWED_ORIGINS=https://172.16.173.34
SDL_PROXY_HTTP_PORT=80
SDL_PROXY_HTTPS_PORT=443
# Wajib true saat dilayani lewat HTTPS, kalau tidak cookie sesi ditolak browser.
SDL_COOKIE_SECURE=true

# --- Peralihan Go -> Express (Tahap 6, docs/PERALIHAN-EXPRESS-PRODUKSI.md) ---
# Pola path yang dilayani api-express, dipisah spasi. Kosong/tidak ada = semua
# ke Go. Terapkan dengan: docker compose ... up -d --no-deps --force-recreate caddy
# SDL_EXPRESS_PATHS=/api/v1/portal/* /api/v1/executive/*

# --- SMTP: WAJIB DIISI, bukan opsional ---
# Superadmin SELALU wajib OTP via email (service.go:345 mustUseOTP).
# Tanpa SMTP valid, login Superadmin gagal dengan 503 email_delivery_unavailable.
# Port harus 465 atau 587. Kelima field di bawah harus terisi semua.
SDL_SMTP_HOST=smtp.gmail.com
SDL_SMTP_PORT=587
SDL_SMTP_USER=alamat@gmail.com
SDL_SMTP_PASSWORD=app_password_16_karakter
SDL_SMTP_FROM=alamat@gmail.com

# --- Opsional ---
SDL_DEV_SUPERADMIN_WORKSPACE=false
